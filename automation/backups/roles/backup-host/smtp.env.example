# Copy to ~/.openg2p/keystore/smtp.env (or any path) and set
# alerting.smtp_env_file / alerting.email_enabled in backup-config.yaml.
# Install copies this file to /etc/openg2p-backup/smtp.env (mode 0600).
#
# NEVER commit the filled-in file.

SMTP_HOST=smtp.example.gov
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=backup-noreply@example.gov
SMTP_PASS=change-me
# Quote SMTP_FROM whenever it contains spaces or <angle brackets> —
# this file is `source`d by bash; unquoted <...> is treated as redirection.
SMTP_FROM="OpenG2P Backup <backup-noreply@example.gov>"
MAIL_TO=ops@example.gov
